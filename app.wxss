@import "./components/prefs-form/prefs-form.wxss";

/* 全局样式与设计变量：8-bit NES 多彩像素主题 */
page {
  /* 描边与文字用黑，强调色红黄蓝，成功用绿，底色白 */
  --ink: #1a1a1a;        /* 黑：主文字 / 描边 */
  --ink2: #4a4a4a;       /* 灰：次级文字 */
  --ink3: #7a7a7a;       /* 中灰：弱化文字（提升白底对比度） */
  --line: #1a1a1a;       /* 描边线 */
  --bg: #ffffff;         /* 页面底色：白 */
  --card: #ffffff;       /* 卡片底色：白 */
  --card2: #cfe3ff;      /* 浅蓝：次级填充（标签 / 轨道 / 提示框） */
  --primary: #e60012;    /* NES 红：主按钮 / 选中 / 进度 */
  --primary-bg: #ffd800; /* NES 黄：芯片 / 徽章 / 高亮 */
  --green: #00a800;      /* NES 绿：成功 */
  --green-bg: #c8f000;   /* 浅绿 */
  --blue: #0058f8;       /* NES 蓝：hero 主视觉 / 时长进度 */

  /* 统一描边宽度与硬阴影 */
  --px: 4rpx;
  --pxs: 3rpx;
  --shadow: 6rpx 6rpx 0 0 #1a1a1a;

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
  /* 像素字体由 page-meta 的 page-style 按开关切换，见 utils/font.js */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  /* 关抗锯齿，保留硬边，更像像素 */
  -webkit-font-smoothing: none;
  font-smooth: never;
  letter-spacing: 1rpx;
}

/* 通用卡片：直角 + 描边 + 硬阴影 + 网点纹理 */
.g-card {
  background: var(--card);
  /* 棋盘格叠底色，形成颗粒质感 */
  background-image:
    linear-gradient(45deg, rgba(26, 26, 26, 0.05) 25%, transparent 25%, transparent 75%, rgba(26, 26, 26, 0.05) 75%),
    linear-gradient(45deg, rgba(26, 26, 26, 0.05) 25%, transparent 25%, transparent 75%, rgba(26, 26, 26, 0.05) 75%);
  background-size: 8rpx 8rpx;
  background-position: 0 0, 4rpx 4rpx;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  padding: 28rpx;
  box-sizing: border-box;
}

.btn {
  height: 92rpx;
  border-radius: 0;
  border: var(--px) solid var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-sizing: border-box;
}

.btn-primary {
  background: var(--primary);
  color: var(--card);
}

.btn-ghost {
  background: var(--card);
  color: var(--ink);
  border: var(--px) solid var(--ink);
}

.tag {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 0;
  border: var(--pxs) solid var(--ink);
  background: var(--card2);
  color: var(--ink2);
}

/* 自定义计划：黄底 */
.tag-custom {
  background: var(--primary-bg);
  color: var(--ink);
  border-color: var(--ink);
  font-weight: 700;
}

/* 今日推荐：绿底 */
.tag-rec {
  background: var(--green-bg);
  color: var(--ink);
  border-color: var(--ink);
  font-weight: 700;
}

.sub {
  color: var(--ink2);
}

.weak {
  color: var(--ink3);
}

.num {
  font-weight: 700;
}

.row {
  display: flex;
  align-items: center;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

/* 强制全站直角，清掉组件默认圆角 */
button,
input,
textarea,
image,
navigator,
scroll-view,
picker,
slider,
switch,
checkbox,
radio,
progress,
cover-view {
  border-radius: 0;
}

button::after,
input::after {
  border-radius: 0;
}

/* 原生控件默认不继承页面字体，显式继承才能跟随字体开关 */
button,
input,
textarea {
  font-family: inherit;
}

/* 弹窗：.px-mask > .px-dialog > 标题/正文/按钮 */
.px-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 26, 26, 0.5);
}

.px-dialog {
  width: 600rpx;
  box-sizing: border-box;
  padding: 40rpx 32rpx 28rpx;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  background: var(--card);
}

.px-dialog-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.px-dialog-copy {
  margin-top: 16rpx;
  color: var(--ink2);
  font-size: 25rpx;
  line-height: 1.65;
  text-align: center;
}

.px-dialog-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.px-dialog-btn {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 700;
}

.px-dialog-btn.cancel {
  background: var(--card2);
  color: var(--ink2);
}

.px-dialog-btn.primary,
.px-dialog-btn.danger {
  background: var(--primary);
  color: var(--card);
}

/* 加载提示，替代 wx.showLoading：.px-loading-mask > .px-loading > 方块 + 文案 */
.px-loading-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 26, 26, 0.5);
}

.px-loading {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 30rpx 44rpx;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  background: var(--card);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.px-loading-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 0;
  background: var(--primary);
  animation: px-loading-blink 0.7s steps(1, end) infinite;
}

@keyframes px-loading-blink {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
}

/* ===== 页面骨架与共用样板，各页 wxss 只写差异 ===== */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.scrollarea {
  flex: 1;
  min-height: 0;
  overflow-y: hidden;
  background: var(--bg);
}

/* 横向内边距与顶部留白全站一致，各页只覆盖 padding-bottom
   （底部操作栏约 200rpx、自定义 tabBar 148rpx + 安全区） */
.page {
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.bottom-space {
  height: 24rpx;
}

/* 底部固定操作栏，profile / account / custom-plan / onboarding 共用 */
.save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: var(--px) solid var(--ink);
  background: var(--card);
}

/* 加载 / 空态 / 重试，需要请求云端的页面共用 */
.loading-box {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 20rpx;
}

.empty-icon {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--ink3);
  margin-bottom: 12rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
}

.empty-sub {
  font-size: 24rpx;
  margin-top: 10rpx;
  text-align: center;
}

/* 场景分段选择，plan / custom-plan 共用 */
.seg {
  display: flex;
  padding: 8rpx;
  background: var(--card2);
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
}

.seg-item {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink2);
  font-size: 28rpx;
  font-weight: 600;
}

.seg-item.on {
  background: var(--primary);
  color: var(--card);
}

.retry-btn {
  margin-top: 28rpx;
  padding: 16rpx 48rpx;
  border: var(--pxs) solid var(--ink);
  background: var(--primary);
  color: var(--card);
  font-size: 26rpx;
  font-weight: 700;
}

