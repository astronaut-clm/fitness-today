/**app.wxss 全局样式与设计变量 —— 8-bit NES 多彩像素主题**/
page {
  /* 描边/文字用黑，强调色红黄蓝，成功用绿，底色为白 */
  --ink: #1a1a1a;        /* 黑：主文字 / 描边 */
  --ink2: #4a4a4a;       /* 灰：次级文字 */
  --ink3: #7a7a7a;       /* 中灰：弱化文字（提升白底对比度） */
  --line: #1a1a1a;       /* 描边线 */
  --bg: #ffffff;         /* 页面底色：白 */
  --card: #ffffff;       /* 卡片底色：白 */
  --card2: #cfe3ff;      /* 浅蓝：次级填充（标签 / 轨道 / 提示框） */
  --primary: #e60012;    /* NES 红：主按钮 / 选中 / 进度 */
  --primary2: #0058f8;   /* NES 蓝 */
  --primary-bg: #ffd800; /* NES 黄：芯片 / 徽章 / 高亮 */
  --green: #00a800;      /* NES 绿：成功 */
  --green-bg: #c8f000;   /* 浅绿 */

  /* 像素风尺寸：统一描边与硬阴影 */
  --px: 4rpx;
  --pxs: 3rpx;
  --shadow: 6rpx 6rpx 0 0 #1a1a1a;

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
  /* 像素字体优先，未加载时回退系统字体栈 */
  font-family: "Zpix", -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  /* 关闭抗锯齿，保留生硬锯齿，更接近像素观感 */
  -webkit-font-smoothing: none;
  font-smooth: never;
  letter-spacing: 1rpx;
}

/* 通用卡片：直角 + 深色描边 + 像素硬阴影 + 抖动网点纹理 */
.g-card {
  background: var(--card);
  /* 抖动网点：4x4 棋盘格叠在底色上形成颗粒质感 */
  background-image:
    linear-gradient(45deg, rgba(26, 26, 26, 0.05) 25%, transparent 25%, transparent 75%, rgba(26, 26, 26, 0.05) 75%),
    linear-gradient(45deg, rgba(26, 26, 26, 0.05) 25%, transparent 25%, transparent 75%, rgba(26, 26, 26, 0.05) 75%);
  background-size: 8rpx 8rpx;
  background-position: 0 0, 4rpx 4rpx;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  padding: 28rpx;
  box-sizing: border-box;
}

.btn {
  height: 92rpx;
  border-radius: 0;
  border: var(--px) solid var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-sizing: border-box;
}

.btn-primary {
  background: var(--primary);
  color: var(--card);
}

.btn-ghost {
  background: var(--card);
  color: var(--ink);
  border: var(--px) solid var(--ink);
}

.tag {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 0;
  border: var(--pxs) solid var(--ink);
  background: var(--card2);
  color: var(--ink2);
}

/* 自定义计划标签：黄底强调，用于卡片左上角标识来源 */
.tag-custom {
  background: var(--primary-bg);
  color: var(--ink);
  border-color: var(--ink);
  font-weight: 700;
}

/* 当日推荐计划标签：绿底强调，用于计划库标识推荐来源 */
.tag-rec {
  background: var(--green-bg);
  color: var(--ink);
  border-color: var(--ink);
  font-weight: 700;
}

.sub {
  color: var(--ink2);
}

.weak {
  color: var(--ink3);
}

.num {
  font-weight: 700;
}

.row {
  display: flex;
  align-items: center;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

/* ===== 复古屏幕增强：像素转角 ===== */

/* 像素转角：强制全站直角，清除组件默认圆角 */
button,
input,
textarea,
image,
navigator,
scroll-view,
picker,
slider,
switch,
checkbox,
radio,
progress,
cover-view {
  border-radius: 0;
}

button::after,
input::after {
  border-radius: 0;
}

/* 统一像素弹窗，跟随全局像素字体。用法：.px-mask > .px-dialog > 标题/正文/输入/按钮 */
.px-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 26, 26, 0.5);
}

.px-dialog {
  width: 600rpx;
  box-sizing: border-box;
  padding: 40rpx 32rpx 28rpx;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  background: var(--card);
}

.px-dialog-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.px-dialog-copy {
  margin-top: 16rpx;
  color: var(--ink2);
  font-size: 25rpx;
  line-height: 1.65;
  text-align: center;
}

.px-dialog-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.px-dialog-btn {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 700;
}

.px-dialog-btn.cancel {
  background: var(--card2);
  color: var(--ink2);
}

.px-dialog-btn.primary,
.px-dialog-btn.danger {
  background: var(--primary);
  color: var(--card);
}

/* 统一像素加载提示，替代原生 wx.showLoading。用法：.px-loading-mask > .px-loading > 方块 + 文案 */
.px-loading-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 26, 26, 0.5);
}

.px-loading {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 30rpx 44rpx;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  background: var(--card);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.px-loading-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 0;
  background: var(--primary);
  animation: px-loading-blink 0.7s steps(1, end) infinite;
}

@keyframes px-loading-blink {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
}

/* ===== 页面骨架与共用样板（各页 wxss 只写自身差异） ===== */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.scrollarea {
  flex: 1;
  min-height: 0;
  overflow-y: hidden;
  background: var(--bg);
}

.bottom-space {
  height: 24rpx;
}

/* 底部固定操作栏（profile / account 等页共用） */
.save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: var(--px) solid var(--ink);
  background: var(--card);
}

/* 居中加载/空态/重试（rank / feed / admin-report 等页共用） */
.loading-box {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 20rpx;
}

.empty-icon {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--ink3);
  margin-bottom: 12rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
}

.empty-sub {
  font-size: 24rpx;
  margin-top: 10rpx;
  text-align: center;
}

/* 场景分段选择（plan / custom-plan 页共用） */
.seg {
  display: flex;
  padding: 8rpx;
  background: var(--card2);
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
}

.seg-item {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink2);
  font-size: 28rpx;
  font-weight: 600;
}

.seg-item.on {
  background: var(--primary);
  color: var(--card);
}

.retry-btn {
  margin-top: 28rpx;
  padding: 16rpx 48rpx;
  border: var(--pxs) solid var(--ink);
  background: var(--primary);
  color: var(--card);
  font-size: 26rpx;
  font-weight: 700;
}

/* ===== 偏好配置表单（profile / onboarding 共用，结构见 pages/common/prefs-form.wxml） ===== */
.intro {
  margin: 8rpx 8rpx 24rpx;
}

.intro-title {
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 800;
}

.intro-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.section {
  margin-top: 20rpx;
}

.section-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.required-tag {
  margin-left: 12rpx;
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 700;
}

.goal-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.goal-item {
  flex: 0 0 calc((100% - 16rpx) / 2);
  min-height: 126rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  background: var(--card);
}

.goal-item.on {
  border-color: var(--ink);
  background: var(--primary-bg);
}

.goal-name {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.goal-desc {
  margin-top: 7rpx;
  color: var(--ink3);
  font-size: 20rpx;
  line-height: 1.35;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.chip {
  padding: 13rpx 22rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  color: var(--ink2);
  font-size: 24rpx;
}

.chip.on {
  border-color: var(--ink);
  color: var(--ink);
  background: var(--primary-bg);
  font-weight: 700;
}

.slider-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 26rpx;
  color: var(--ink);
  font-size: 25rpx;
}

.slider-copy {
  flex: none;
  width: 190rpx;
}

.slider-row .weak {
  margin-top: 5rpx;
  font-size: 21rpx;
}

.slider-area {
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

.slider-row slider {
  width: 100%;
}
