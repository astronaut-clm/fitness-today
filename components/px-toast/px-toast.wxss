.px-toast {
  position: fixed;
  left: 50%;
  top: 50%;
  z-index: 1100;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  gap: 14rpx;
  max-width: 560rpx;
  box-sizing: border-box;
  padding: 26rpx 40rpx;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  background: var(--card);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  /* 不拦截点击：与原生 toast 一致，不阻塞底层交互 */
  pointer-events: none;
}

/* 默认（错误/警告）：红底方框 + 叉子，置于提示开头 */
.px-toast-icon {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  background: var(--primary);
}

/* 叉子：两条旋转硬边条，避免依赖像素字体是否包含 ✕ 字形 */
.px-toast-icon::before,
.px-toast-icon::after {
  content: '';
  position: absolute;
  width: 18rpx;
  height: 4rpx;
  background: var(--card);
}

.px-toast-icon::before {
  transform: rotate(45deg);
}

.px-toast-icon::after {
  transform: rotate(-45deg);
}

/* 成功：绿底方框 + 对勾（用边框折出，同样不依赖字形） */
.px-toast-icon.success {
  background: var(--green);
}

.px-toast-icon.success::before {
  content: none;
}

.px-toast-icon.success::after {
  position: static;
  width: 8rpx;
  height: 16rpx;
  margin-top: -4rpx;
  background: transparent;
  border: solid var(--card);
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
}

.px-toast-text {
  flex: 1;
  text-align: center;
}
