/* custom-tab-bar/index.wxss —— 8-bit NES 多彩像素风底部导航
   图标为 box-shadow 硬像素绘制（无模糊），不依赖任何图片资源。
   所有变量均带兜底值，避免组件根节点取不到 app.wxss 的设计令牌。 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  box-sizing: border-box;
  background: var(--card, #ffffff);
  /* 网点纹理，与全站复古质感统一 */
  background-image: radial-gradient(rgba(26, 26, 26, 0.10) 1.5rpx, transparent 1.6rpx);
  background-size: 8rpx 8rpx;
  border-top: var(--px, 4rpx) solid var(--ink, #1a1a1a);
  padding-bottom: env(safe-area-inset-bottom);
  font-family: "Zpix", "Press Start 2P", "Courier New", Menlo, Consolas, monospace;
  -webkit-font-smoothing: none;
}

.tabbar-inner {
  display: flex;
  height: 100rpx;
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  --c: #7a7a7a;
  color: #7a7a7a;
}

.tab-item.on {
  --c: #e60012;
  color: #e60012;
}

.tab-hover {
  opacity: 0.6;
}

/* 选中标记：图标上方一条像素短线 */
.tab-mark {
  width: 40rpx;
  height: 6rpx;
  margin-bottom: 6rpx;
  background: transparent;
}

.tab-item.on .tab-mark {
  background: #e60012;
}

.tab-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

/* 单个像素块：6rpx，直角、无模糊 */
.px {
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 6rpx;
  background: var(--c);
}

.tab-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* ===== 像素图标：home（8x8 房子）===== */
.icon-home {
  box-shadow:
    18rpx 0 0 0 var(--c),
    24rpx 0 0 0 var(--c),
    12rpx 6rpx 0 0 var(--c),
