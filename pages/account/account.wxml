<navigation-bar title="个人设置" color="#1A1A1A" background="#FFFFFF"></navigation-bar>
<px-toast></px-toast>
<scroll-view class="scrollarea" scroll-y>
  <view class="page">
    <view class="avatar-wrap">
      <view class="avatar-clip">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
        <view wx:else class="avatar-fallback">{{avatarChar}}</view>
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none"></button>
      </view>
      <view class="weak avatar-tip">点击更换头像</view>
    </view>

    <view class="g-card form-card">
      <view class="form-row">
        <view class="form-label">昵称</view>
        <input class="form-input" type="nickname" value="{{nickname}}" maxlength="20" placeholder="请输入昵称" placeholder-class="weak" bindinput="onNicknameInput" bindblur="onNicknameBlur" />
      </view>
    </view>

    <view class="g-card menu-card" bindtap="goPrefs">
      <view class="menu-copy">
        <view class="menu-title">偏好配置</view>
        <view class="weak menu-sub">训练目标 · 场地 · 器械 · 每周目标</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="g-card menu-card" bindtap="goCustomPlans">
      <view class="menu-copy">
        <view class="menu-title">自定义计划</view>
        <view class="weak menu-sub">{{customHint}}</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="g-card section">
      <view class="switch-row">
        <view class="menu-copy">
          <view class="menu-title">使用像素字体</view>
          <view class="weak menu-sub">开启为 8-bit 点阵，关闭使用系统字体</view>
        </view>
        <switch checked="{{usePixelFont}}" color="#e60012" bindchange="onTogglePixelFont" />
      </view>
    </view>

    <view wx:if="{{isAdmin}}" class="g-card menu-card" bindtap="goAdminReport">
      <view class="menu-copy">
        <view class="menu-title">举报审核</view>
        <view class="weak menu-sub">查看铁友圈待处理举报</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="bottom-space"></view>
  </view>
</scroll-view>
<view class="save-bar">
  <view class="btn logout-save-btn" bindtap="onLogout">退出登录</view>
</view>
<px-dialog show="{{showLogoutConfirm}}" title="退出并清空记录？" copy="再次登录会自动恢复全部云端数据"
  cancel-text="再想想" confirm-text="退出并清空" danger bind:cancel="onCancelLogout" bind:confirm="onConfirmLogout" />

<!-- 保存中：页内像素加载层（原生 showLoading 无法用自定义字体） -->
<view class="px-loading-mask" wx:if="{{savingShow}}" catchtouchmove="noop">
  <view class="px-loading">
    <view class="px-loading-dot"></view>
    <text>保存中…</text>
  </view>
</view>
