.page { padding-top: 36rpx; padding-bottom: 200rpx; }

.avatar-wrap { display: flex; flex-direction: column; align-items: center; padding: 8rpx 0 34rpx; }
/* 方形头像容器，按钮做透明覆盖层负责点选 */
.avatar-clip {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  overflow: hidden;
  background: var(--card2);
  box-sizing: border-box;
  flex: none;
}
.avatar-btn {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  opacity: 0;
  background: transparent;
}
.avatar-btn::after { content: none; border: 0; }
.avatar-img { width: 100%; height: 100%; display: block; }
.avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  font-size: 76rpx;
  font-weight: 700;
}
.avatar-tip { margin-top: 16rpx; font-size: 24rpx; }

.form-card { padding: 8rpx 28rpx; }
.form-row { display: flex; align-items: center; min-height: 104rpx; }
.form-label { flex: none; width: 132rpx; color: var(--ink); font-size: 29rpx; font-weight: 600; }
.form-input { flex: 1; min-width: 0; color: var(--ink); font-size: 29rpx; }

.menu-card { display: flex; align-items: center; gap: 18rpx; margin-top: 22rpx; padding: 24rpx 26rpx; }
.menu-copy { flex: 1; min-width: 0; color: var(--ink); font-size: 27rpx; }
.menu-title { font-weight: 600; }
.menu-sub { margin-top: 6rpx; font-size: 21rpx; }
.menu-arrow { color: var(--ink3); font-size: 40rpx; line-height: 1; }

.logout-save-btn { background: #e60012; color: #ffffff; }
