<navigation-bar title="举报审核" color="#1A1A1A" background="#FFFFFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y>
  <view class="page">
    <view class="admin-head">
      <view class="admin-title">举报审核</view>
      <view class="weak admin-sub">仅管理员可见 · 共 {{rows.length}} 条待处理</view>
    </view>

    <block wx:if="{{!loaded && loading}}">
      <view class="g-card loading-box">
        <view class="px-loading">
          <view class="px-loading-dot"></view>
          <text>加载中…</text>
        </view>
      </view>
    </block>

    <block wx:elif="{{error}}">
      <view class="empty g-card">
        <view class="empty-icon">!</view>
        <view>{{errorTip}}</view>
        <text wx:if="{{myOpenid}}" class="weak empty-sub openid" user-select>我的 openid：{{myOpenid}}</text>
        <view class="retry-btn" bindtap="onRetry">重新加载</view>
      </view>
    </block>

    <block wx:elif="{{rows.length}}">
      <view class="report-list">
        <view wx:for="{{rows}}" wx:key="targetId" class="report g-card">
          <view class="report-top">
            <view class="report-type">动态</view>
            <view class="report-count">被举报 {{item.count}} 次</view>
            <view class="weak report-time">{{item.timeText}}</view>
          </view>

          <view class="report-meta">作者：{{item.author}}</view>
          <view class="report-content">{{item.content}}</view>

          <view class="weak report-reporters">举报人：{{item.reportersText}}</view>

          <view class="report-acts">
            <view class="report-act" data-index="{{index}}" bindtap="onIgnoreTap">忽略</view>
            <view class="report-act danger" data-index="{{index}}" bindtap="onDeleteTap">删除</view>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="empty g-card">
        <view class="empty-icon">✓</view>
        <view>暂无待处理举报</view>
        <view class="weak empty-sub">有新举报时会出现在这里</view>
      </view>
    </block>

    <view class="bottom-space"></view>
  </view>
</scroll-view>

<px-dialog show="{{showConfirm}}" title="{{confirmTitle}}"
  copy="{{confirmOp === 'delete' ? '内容将被永久删除，不可恢复。' : '这些举报将标记为已处理，内容保留。'}}"
  confirm-text="确定" danger="{{confirmOp === 'delete'}}" bind:cancel="onCancelConfirm" bind:confirm="confirmAction" />

<px-toast></px-toast>
