.page {
  padding: 24rpx 32rpx 48rpx;
}

.admin-head {
  margin: 8rpx 8rpx 24rpx;
}

.admin-title {
  font-size: 40rpx;
  font-weight: 800;
}

.admin-sub {
  font-size: 23rpx;
  margin-top: 8rpx;
}

.report-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.report {
  padding: 24rpx;
}

.report-top {
  display: flex;
  align-items: center;
}

.report-type {
  flex: none;
  padding: 4rpx 16rpx;
  border: var(--pxs) solid var(--ink);
  background: var(--primary-bg);
  font-size: 22rpx;
  font-weight: 700;
}

.report-count {
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary);
}

.report-time {
  margin-left: auto;
  font-size: 22rpx;
}

.report-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink2);
}

.report-content {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border: var(--pxs) solid var(--ink);
  background: var(--card2);
  font-size: 27rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.report-reporters {
  margin-top: 14rpx;
  font-size: 22rpx;
}

.report-acts {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.report-act {
  padding: 10rpx 26rpx;
  border: var(--pxs) solid var(--ink);
  background: var(--card2);
  color: var(--ink2);
  font-size: 24rpx;
  font-weight: 700;
}

.report-act.danger {
  background: var(--primary);
  color: var(--card);
}

.openid {
  margin-top: 16rpx;
  padding: 0 20rpx;
  word-break: break-all;
  text-align: center;
}

.bottom-space {
  height: 60rpx;
}
