<!-- 偏好配置表单：profile 与 onboarding 两页共用（事件方法见 utils/prefs-form.js，样式在 app.wxss） -->
<template name="prefsForm">
  <view class="g-card section">
    <view class="section-title">你的主要目标<text wx:if="{{required}}" class="required-tag">必选</text></view>
    <view class="goal-list">
      <view wx:for="{{goals}}" wx:key="value" class="goal-item {{item.selected ? 'on' : ''}}" data-value="{{item.value}}" bindtap="onChooseGoal">
        <view class="goal-name">{{item.name}}</view>
        <view class="goal-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="g-card section">
    <view class="section-title">常用训练地点</view>
    <view class="chip-row">
      <view wx:for="{{scenes}}" wx:key="value" class="chip {{item.selected ? 'on' : ''}}" data-value="{{item.value}}" bindtap="onToggleScene">{{item.name}}</view>
    </view>
  </view>

  <view class="g-card section">
    <view class="section-title">训练经验</view>
    <view class="chip-row">
      <view wx:for="{{experiences}}" wx:key="name" class="chip {{item.selected ? 'on' : ''}}" data-value="{{item.name}}" bindtap="onChooseExperience">{{item.name}}</view>
    </view>
  </view>

  <view class="g-card section">
    <view class="section-title">可用器械</view>
    <view class="chip-row">
      <view wx:for="{{equipment}}" wx:key="value" class="chip {{item.selected ? 'on' : ''}}" data-value="{{item.value}}" bindtap="onToggleEquipment">{{item.name}}</view>
    </view>
  </view>

  <view class="g-card section">
    <view class="section-title">每周目标</view>
    <view class="slider-row">
      <view class="slider-copy"><view>每周训练天数</view><view class="weak">{{weeklyTargetDays}} 天</view></view>
      <view class="slider-area">
        <slider min="1" max="7" step="1" value="{{weeklyTargetDays}}" activeColor="#E60012" bindchange="onDaysChange" />
      </view>
    </view>
    <view class="slider-row">
      <view class="slider-copy"><view>每周训练时长</view><view class="weak">{{weeklyTargetMinutes}} 分钟</view></view>
      <view class="slider-area">
        <slider min="30" max="600" step="30" value="{{weeklyTargetMinutes}}" activeColor="#E60012" bindchange="onMinutesChange" />
      </view>
    </view>
  </view>
</template>
