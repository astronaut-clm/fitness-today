<navigation-bar title="自定义计划"></navigation-bar>
<px-toast></px-toast>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">

    <view class="g-card section">
      <view class="section-title">计划归属</view>
      <view class="seg">
        <view
          wx:for="{{sceneTabs}}"
          wx:key="value"
          class="seg-item {{scene === item.value ? 'on' : ''}}"
          data-scene="{{item.value}}"
          bindtap="onScene"
        >{{item.name}}</view>
      </view>
      <view class="weak seg-tip">设置后将展示在计划的最上方，方便快速选择</view>
    </view>

    <view class="g-card section">
      <view class="section-title">计划名称</view>
      <input class="name-input" value="{{name}}" maxlength="16" placeholder="给计划起个名字" placeholder-class="weak" bindinput="onName" />
    </view>

    <view class="g-card section">
      <view class="row">
        <view class="flex1 section-title">已选动作</view>
        <text class="weak">{{selected.length}} 个</text>
      </view>
      <view wx:if="{{selected.length === 0}}" class="weak empty-tip">从下方动作库点击添加动作</view>
      <view class="sel-item" wx:for="{{selected}}" wx:key="actionId">
        <view class="sel-top">
          <view class="flex1">
            <view class="sel-name">{{item.name}}</view>
            <view class="weak sel-meta">{{item.category}} · {{item.equipment}}</view>
          </view>
          <text class="tag">{{item.level}}</text>
          <view class="sel-del" data-index="{{index}}" bindtap="onRemoveAction">删除</view>
        </view>
        <view class="sel-config">
          <view class="cfg-block">
            <text class="cfg-label">组数</text>
            <view class="stepper">
              <text class="step-btn" data-index="{{index}}" data-delta="-1" bindtap="onSets">−</text>
              <text class="step-value">{{item.sets}}</text>
              <text class="step-btn" data-index="{{index}}" data-delta="1" bindtap="onSets">＋</text>
            </view>
          </view>
          <view class="cfg-block cfg-reps">
            <text class="cfg-label">目标</text>
            <input class="reps-input" value="{{item.targetText}}" maxlength="10" placeholder="如 12次 / 30秒 / 力竭" placeholder-class="weak" data-index="{{index}}" bindinput="onTarget" />
          </view>
        </view>
      </view>
    </view>

    <view class="g-card section">
      <view class="section-title">动作库</view>
      <scroll-view scroll-x class="cat-scroll" enable-flex>
        <view class="cat-inner">
          <view wx:for="{{cats}}" wx:key="*this" class="cat {{cat === item ? 'on' : ''}}" data-cat="{{item}}" bindtap="onCat">{{item}}</view>
        </view>
      </scroll-view>
      <view class="pick-list">
        <view class="pick-item {{item.checked ? 'on' : ''}}" wx:for="{{picker}}" wx:key="id" data-id="{{item.id}}" bindtap="onToggleAction">
          <view class="flex1">
            <view class="pick-name">{{item.name}}<text wx:if="{{item.checked}}" class="pick-check">✓</text></view>
            <view class="weak pick-meta">{{item.equipment}} · {{item.muscles}}</view>
          </view>
          <text class="tag">{{item.level}}</text>
        </view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </view>
</scroll-view>
<view class="save-bar">
  <view class="btn btn-primary save-btn" bindtap="onSave">保存计划</view>
</view>

<px-dialog show="{{switchConfirm}}" title="有未保存的修改" copy="切换场景会丢弃当前场景的修改，确定切换？"
  confirm-text="放弃并切换" mask-close="{{false}}" bind:cancel="onCancelSceneSwitch" bind:confirm="onConfirmSceneSwitch" />
