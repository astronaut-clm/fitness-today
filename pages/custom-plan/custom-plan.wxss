.page { padding-bottom: 200rpx; }
.section { margin-top: 22rpx; }

.seg { margin-top: 20rpx; }
.seg-tip { margin-top: 16rpx; font-size: 22rpx; }

.name-input { margin-top: 20rpx; height: 88rpx; padding: 0 22rpx; border: var(--pxs) solid var(--ink); border-radius: 0; box-sizing: border-box; color: var(--ink); background: var(--card2); font-size: 28rpx; }

.empty-tip { margin-top: 20rpx; font-size: 24rpx; }
.sel-item { margin-top: 20rpx; padding: 20rpx; border: var(--pxs) solid var(--ink); border-radius: 0; background: var(--card); }
.sel-top { display: flex; align-items: center; gap: 14rpx; }
.sel-name { color: var(--ink); font-size: 28rpx; font-weight: 700; }
.sel-meta { margin-top: 6rpx; font-size: 22rpx; }
.sel-del { flex: none; padding: 6rpx 16rpx; border: var(--pxs) solid var(--ink); border-radius: 0; color: var(--primary); font-size: 22rpx; font-weight: 700; }
.sel-config { display: flex; align-items: center; gap: 24rpx; margin-top: 20rpx; }
.cfg-block { display: flex; align-items: center; gap: 12rpx; }
.cfg-reps { flex: 1; min-width: 0; }
.cfg-label { flex: none; color: var(--ink2); font-size: 24rpx; }
.stepper { display: flex; align-items: center; }
.step-btn { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border: var(--pxs) solid var(--ink); border-radius: 0; background: var(--card2); color: var(--ink); font-size: 32rpx; font-weight: 700; }
.step-value { min-width: 60rpx; text-align: center; color: var(--ink); font-size: 28rpx; font-weight: 700; }
.reps-input { flex: 1; min-width: 0; height: 56rpx; padding: 0 14rpx; border: var(--pxs) solid var(--ink); border-radius: 0; box-sizing: border-box; background: var(--card2); color: var(--ink); font-size: 26rpx; }

.cat-scroll { margin-top: 20rpx; white-space: nowrap; }
.cat-inner { display: flex; }
.cat { flex: none; padding: 10rpx 24rpx; margin-right: 14rpx; border: var(--pxs) solid var(--ink); border-radius: 0; background: var(--card); color: var(--ink2); font-size: 24rpx; }
.cat.on { background: var(--primary); color: var(--card); font-weight: 700; }
.pick-list { margin-top: 20rpx; }
.pick-item { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 8rpx; border-top: var(--pxs) solid var(--line); }
.pick-item:first-child { border-top: 0; }
.pick-item.on { background: var(--primary-bg); }
.pick-name { color: var(--ink); font-size: 27rpx; font-weight: 600; }
.pick-check { margin-left: 12rpx; color: var(--green); font-weight: 700; }
.pick-meta { margin-top: 6rpx; font-size: 22rpx; }

/* 底部操作栏骨架在 app.wxss 的 .save-bar，这里只加横向排布 */
.save-bar { display: flex; gap: 20rpx; }
.save-btn { flex: 1; }
