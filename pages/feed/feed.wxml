<!-- pages/feed/feed.wxml 铁友圈（跨用户动态） -->
<navigation-bar back="{{true}}" title="铁友圈" color="#1A1A1A" background="#FFFFFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list" bindscrolltolower="loadMore" lower-threshold="80">
  <view class="page">
    <view class="feed-head">
      <view class="feed-title">铁友圈</view>
      <view class="weak feed-sub">分享训练心得，一起坚持下去！</view>
    </view>

    <block wx:if="{{loading && !loaded}}">
      <view class="g-card loading-box">
        <view class="px-loading">
          <view class="px-loading-dot"></view>
          <text>加载中…</text>
        </view>
      </view>
    </block>

    <block wx:elif="{{error}}">
      <view class="empty g-card">
        <view class="empty-icon">!</view>
        <view>动态加载失败</view>
        <view class="weak empty-sub">请检查网络，或确认 social 云函数已部署</view>
        <view class="retry-btn" hover-class="hover" hover-stay-time="100" bindtap="onRetry">重新加载</view>
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{rows.length}}" class="feed-list">
        <view wx:for="{{rows}}" wx:key="id" class="post g-card">
          <view class="post-head">
            <view class="post-avatar-box">
              <image wx:if="{{item.avatar}}" class="post-avatar" src="{{item.avatar}}" mode="aspectFill" data-index="{{index}}" binderror="onAvatarError"></image>
              <view wx:else class="post-avatar post-avatar-fallback">{{item.char}}</view>
            </view>
            <view class="flex1 post-who">
              <view class="post-name">{{item.nickname}}<text wx:if="{{item.isMe}}" class="post-me-tag">我</text></view>
              <view class="weak post-time">{{item.timeText}}</view>
            </view>
            <view class="post-more" hover-class="hover" hover-stay-time="100" data-index="{{index}}" bindtap="onMore">⋯</view>
          </view>

          <view class="post-content">{{item.content}}</view>

          <view class="post-foot">
            <view class="post-act post-comment" hover-class="hover" hover-stay-time="100" data-index="{{index}}" bindtap="openComments">
              <text class="act-text">评论</text>
              <text class="act-count">{{item.commentCount}}</text>
            </view>
            <view class="post-act post-like {{item.liked ? 'on' : ''}}" hover-class="hover" hover-stay-time="100" data-index="{{index}}" bindtap="onLike">
              <text class="act-text">赞</text>
              <text class="act-count">{{item.likeCount}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{loadingMore}}" class="more-hint weak">加载中…</view>
        <view wx:elif="{{!hasMore}}" class="more-hint weak">— 没有更多了 —</view>
      </view>

      <view wx:else class="empty g-card">
        <view class="empty-icon">○</view>
        <view>还没有人发动态</view>
        <view class="weak empty-sub">点击右下角按钮，发布第一条吧~</view>
      </view>
    </block>

    <view class="bottom-space"></view>
  </view>
</scroll-view>

<!-- 发布入口 -->
<view class="fab" hover-class="hover" hover-stay-time="100" bindtap="openPost">＋ 发布</view>

<!-- 发布弹层 -->
<view class="px-mask" wx:if="{{showPostDialog}}" bindtap="closePost" catchtouchmove="noop">
  <view class="px-dialog" catchtap="noop">
    <view class="px-dialog-title">发布动态</view>
    <textarea class="px-dialog-textarea" value="{{draft}}" maxlength="500" placeholder="分享今天的训练感受…"
      show-confirm-bar="{{false}}" bindinput="onDraftInput"></textarea>
    <view class="post-counter weak">{{draftLen}}/500</view>
    <view class="px-dialog-btns">
      <view class="px-dialog-btn cancel" hover-class="hover" hover-stay-time="100" bindtap="closePost">取消</view>
      <view class="px-dialog-btn danger" hover-class="hover" hover-stay-time="100" bindtap="submitPost">{{posting ? '发布中…' : '发布'}}</view>
    </view>
  </view>
</view>

<!-- 删除确认 -->
<view class="px-mask" wx:if="{{showDeleteDialog}}" bindtap="onCancelDelete" catchtouchmove="noop">
  <view class="px-dialog" catchtap="noop">
    <view class="px-dialog-title">删除动态</view>
    <view class="px-dialog-copy">删除后不可恢复，确定删除这条动态吗？</view>
    <view class="px-dialog-btns">
      <view class="px-dialog-btn cancel" hover-class="hover" hover-stay-time="100" bindtap="onCancelDelete">取消</view>
      <view class="px-dialog-btn danger" hover-class="hover" hover-stay-time="100" bindtap="confirmDelete">删除</view>
    </view>
  </view>
</view>

<!-- 举报确认 -->
<view class="px-mask" wx:if="{{showReportDialog}}" bindtap="onCancelReport" catchtouchmove="noop">
  <view class="px-dialog" catchtap="noop">
    <view class="px-dialog-title">举报动态</view>
    <view class="px-dialog-copy">确定举报这条动态吗？我们会尽快核实处理。</view>
    <view class="px-dialog-btns">
      <view class="px-dialog-btn cancel" hover-class="hover" hover-stay-time="100" bindtap="onCancelReport">取消</view>
      <view class="px-dialog-btn primary" hover-class="hover" hover-stay-time="100" bindtap="confirmReport">举报</view>
    </view>
  </view>
</view>

<!-- 评论半屏面板 -->
<view class="px-mask comment-mask" wx:if="{{showComments}}" bindtap="closeComments" catchtouchmove="noop">
  <view class="comment-sheet" catchtap="noop">
    <view class="comment-head">
      <view class="comment-title">评论 <text class="comment-total">{{commentTotal}}</text></view>
      <view class="comment-close" hover-class="hover" hover-stay-time="100" bindtap="closeComments">✕</view>
    </view>

    <scroll-view class="comment-scroll" scroll-y type="list" bindscrolltolower="loadMoreComments" lower-threshold="60">
      <block wx:if="{{commentsLoading && !commentsLoaded}}">
        <view class="comment-empty weak">加载中…</view>
      </block>
      <block wx:elif="{{comments.length}}">
        <view wx:for="{{comments}}" wx:key="id" class="comment-item">
          <view class="comment-avatar-box">
            <image wx:if="{{item.avatar}}" class="comment-avatar" src="{{item.avatar}}" mode="aspectFill" data-index="{{index}}" binderror="onCommentAvatarError"></image>
            <view wx:else class="comment-avatar comment-avatar-fallback">{{item.char}}</view>
          </view>
          <view class="flex1 comment-main">
            <view class="comment-top">
              <text class="comment-name">{{item.nickname}}</text>
              <text class="weak comment-time">{{item.timeText}}</text>
            </view>
            <view class="comment-text">{{item.content}}</view>
          </view>
          <view wx:if="{{item.isMe}}" class="comment-del" hover-class="hover" hover-stay-time="100" data-id="{{item.id}}" bindtap="onDeleteCommentTap">删除</view>
        </view>
        <view wx:if="{{commentsLoadingMore}}" class="comment-more weak">加载中…</view>
        <view wx:elif="{{!commentsHasMore}}" class="comment-more weak">— 没有更多了 —</view>
      </block>
      <view wx:else class="comment-empty weak">还没有评论，来抢沙发～</view>
    </scroll-view>

    <view class="comment-input-row">
      <input class="comment-input" value="{{commentDraft}}" maxlength="200" placeholder="说点什么…" placeholder-class="comment-ph"
        confirm-type="send" bindinput="onCommentInput" bindconfirm="submitComment"></input>
      <view class="comment-send {{commentDraftLen ? '' : 'disabled'}}" hover-class="hover" hover-stay-time="100" bindtap="submitComment">{{commentSending ? '发送中' : '发送'}}</view>
    </view>
  </view>
</view>

<!-- 删除评论确认 -->
<view class="px-mask" wx:if="{{showCommentDelete}}" bindtap="onCancelCommentDelete" catchtouchmove="noop">
  <view class="px-dialog" catchtap="noop">
    <view class="px-dialog-title">删除评论</view>
    <view class="px-dialog-copy">删除后不可恢复，确定删除这条评论吗？</view>
    <view class="px-dialog-btns">
      <view class="px-dialog-btn cancel" hover-class="hover" hover-stay-time="100" bindtap="onCancelCommentDelete">取消</view>
      <view class="px-dialog-btn danger" hover-class="hover" hover-stay-time="100" bindtap="confirmCommentDelete">删除</view>
    </view>
  </view>
</view>

<px-toast></px-toast>
