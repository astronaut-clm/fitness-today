page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 24rpx 32rpx 48rpx;
}

.feed-head {
  margin: 8rpx 8rpx 24rpx;
}

.feed-title {
  font-size: 40rpx;
  font-weight: 800;
}

.feed-sub {
  font-size: 23rpx;
  margin-top: 8rpx;
}

.loading-box {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.post {
  padding: 24rpx;
}

.post-head {
  display: flex;
  align-items: center;
}

.post-avatar-box {
  flex: none;
  margin-right: 18rpx;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  display: block;
  border: var(--pxs) solid var(--ink);
}

.post-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card2);
  font-size: 30rpx;
  font-weight: 700;
}

.post-who {
  min-width: 0;
}

.post-name {
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-me-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border: var(--pxs) solid var(--ink);
  background: var(--primary);
  color: var(--card);
}

.post-time {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.post-more {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink3);
}

.post-content {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.post-foot {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.post-act {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border: var(--pxs) solid var(--ink);
  background: var(--card2);
  color: var(--ink2);
  font-size: 24rpx;
  font-weight: 700;
}

.post-act.on {
  background: var(--primary);
  color: var(--card);
}

.act-count {
  margin-left: 12rpx;
}

.more-hint {
  text-align: center;
  font-size: 23rpx;
  padding: 20rpx 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 20rpx;
}

.empty-icon {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--ink3);
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  margin-top: 10rpx;
  text-align: center;
}

.retry-btn {
  margin-top: 28rpx;
  padding: 16rpx 48rpx;
  border: var(--pxs) solid var(--ink);
  background: var(--primary);
  color: var(--card);
  font-size: 26rpx;
  font-weight: 700;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  padding: 22rpx 40rpx;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  background: var(--primary);
  color: var(--card);
  font-size: 28rpx;
  font-weight: 700;
}

.post-dialog-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.post-dialog-title {
  text-align: left;
}

.post-submit {
  padding: 12rpx 32rpx;
  border: var(--pxs) solid var(--ink);
  background: var(--primary);
  color: var(--card);
  font-size: 26rpx;
  font-weight: 700;
}

.post-submit.off {
  opacity: 0.6;
}

.px-dialog-textarea {
  margin-top: 28rpx;
  width: 100%;
  height: 240rpx;
  padding: 20rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  box-sizing: border-box;
  background: var(--card2);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
}

.post-counter {
  margin-top: 12rpx;
  text-align: right;
  font-size: 22rpx;
}

.post.focus {
  border-color: var(--primary);
  box-shadow: 6rpx 6rpx 0 0 var(--primary);
}

.bottom-space {
  height: 140rpx;
}

.hover {
  opacity: 0.86;
}
