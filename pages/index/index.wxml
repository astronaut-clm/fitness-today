<navigation-bar back="{{false}}" color="#1A1A1A" background="#FFFFFF"></navigation-bar>
<px-toast></px-toast>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <block wx:if="{{loggedIn}}">
    <view class="head">
      <view class="flex1">
        <view class="head-date weak">{{dateText}}</view>
      </view>
      <view class="head-actions">
        <view wx:if="{{streak > 0}}" class="head-note streak">连续 {{streak}} 天</view>
        <view wx:else class="head-note">今日开练</view>
      </view>
    </view>

    <block wx:if="{{!isLogged}}">
      <view class="hero">
        <view class="hero-title">练了吧？</view>
        <view class="hero-sub" wx:if="{{recPlan}}">推荐：{{recPlan.name}} · {{recPlan.duration}} 分钟 · 约 {{recPlan.calories}} kcal</view>
        <view class="hero-reason" wx:if="{{recPlan && recPlan.reason}}">{{recPlan.reason}}</view>
        <view class="hero-tags" wx:if="{{recPlan}}"><text class="h-tag">{{recPlan.sceneName}}</text><text class="h-tag">{{recPlan.level}}</text></view>
        <view class="hero-btns">
          <view class="hbtn hbtn-solid hbtn-short" hover-class="hover" hover-stay-time="100" bindtap="goRecPlan">开始今日训练</view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="hero hero-done">
        <view class="hero-title">干得漂亮！</view>
        <view class="hero-sub">今天完成 {{todaySummary.count}} 次训练 · 共 {{todaySummary.minutes}} 分钟</view>
        <view class="hero-reason" wx:if="{{todaySummary.latestName}}">最近完成：{{todaySummary.latestName}}</view>
        <view class="hero-btns">
          <view class="hbtn hbtn-solid hbtn-short" hover-class="hover" hover-stay-time="100" bindtap="goRecPlan">再练一次 Bro!</view>
        </view>
      </view>
    </block>

    <block wx:if="{{goalReady}}">
      <view class="g-card goal-card">
        <view class="row"><view class="flex1 week-title">本周目标</view><text class="weak">{{insight.weekDays}}/{{insight.targetDays}} 天</text></view>
        <view class="progress-label"><text>训练天数</text><text>{{insight.dayPercent}}%</text></view>
        <view class="progress-track"><view class="progress-fill" style="{{insight.dayBar}}"></view></view>
        <view class="progress-label"><text>训练时长</text><text>{{insight.weekMinutes}}/{{insight.targetMinutes}} 分钟</text></view>
        <view class="progress-track"><view class="progress-fill blue" style="{{insight.minuteBar}}"></view></view>
        <view class="coverage" wx:if="{{insight.coverage.length}}"><text class="weak">覆盖：</text><text wx:for="{{insight.coverage}}" wx:key="name" class="coverage-tag">{{item.name}}</text></view>
      </view>
    </block>
    <block wx:else>
      <view class="g-card goal-guide" hover-class="hover" hover-stay-time="100" bindtap="goProfile">
        <view class="row">
          <view class="flex1">
            <view class="goal-guide-title">你的本周目标</view>
            <view class="goal-guide-sub weak">定下每周目标，首页即可跟踪进度</view>
          </view>
          <view class="goal-guide-btn">去设置</view>
        </view>
      </view>
    </block>

    <view class="entry-row">
      <view class="entry-card g-card" hover-class="hover" hover-stay-time="100" bindtap="goRank">
        <view class="entry-badge">榜</view>
        <view class="flex1 entry-main">
          <view class="entry-title">排行榜</view>
          <view class="weak entry-sub">看看本月谁练得最多</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>

      <view class="entry-card g-card" hover-class="hover" hover-stay-time="100" bindtap="goFeed">
        <view class="entry-badge blue">圈</view>
        <view class="flex1 entry-main">
          <view class="entry-title">铁友圈</view>
          <view class="weak entry-sub">分享训练心得，互相打气</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>
    </view>
    </block>

    <block wx:else>
      <view class="login-guide">
        <view class="login-guide-title">练了吧？</view>
        <view class="weak login-guide-sub">登录后即可开始训练、查看排行榜与铁友圈</view>
      </view>
      <view class="login-card g-card">
        <view class="login-avatar">练</view>
        <view class="flex1 login-main">
          <view class="login-title">请先登录</view>
          <view class="weak login-sub">可选择微信头像一键登录</view>
        </view>
        <button class="login-pill" open-type="chooseAvatar" bindchooseavatar="onLoginOneTap" hover-class="hover" hover-stay-time="100">点击登录</button>
      </view>
    </block>
  </view>
</scroll-view>

<view class="px-mask" wx:if="{{loginFailShow}}" bindtap="onCloseLoginFail" catchtouchmove="noop">
  <view class="px-dialog" catchtap="noop">
    <view class="px-dialog-title">登录未完成</view>
    <view class="px-dialog-copy">请确认已部署 login 云函数并创建 ft_users 集合后重试。</view>
    <view class="px-dialog-btns">
      <view class="px-dialog-btn primary" hover-class="hover" hover-stay-time="100" bindtap="onCloseLoginFail">知道了</view>
    </view>
  </view>
</view>

<!-- 登录中：页内像素加载层 -->
<view class="px-loading-mask" wx:if="{{loginBusy}}" catchtouchmove="noop">
  <view class="px-loading">
    <view class="px-loading-dot"></view>
    <text>登录中…</text>
  </view>
</view>
