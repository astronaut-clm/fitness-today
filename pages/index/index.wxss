.page {
  padding: 8rpx 32rpx calc(148rpx + env(safe-area-inset-bottom));
}

.head {
  display: flex;
  align-items: center;
  margin: 4rpx 8rpx 20rpx;
}

.head-date {
  margin-top: 6rpx;
  font-size: 26rpx;
}

.head-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.head-note {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink2);
}

.head-note.streak {
  color: #b26a00;
}

/* 功能入口（本周目标下方） */
.entry-row {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
  margin-bottom: 28rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.entry-badge {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  border: var(--pxs) solid var(--ink);
  background: var(--primary-bg);
  font-size: 32rpx;
  font-weight: 800;
}

.entry-badge.blue {
  background: var(--card2);
}

.entry-main {
  min-width: 0;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 700;
}

.entry-sub {
  font-size: 23rpx;
  margin-top: 6rpx;
}

.entry-arrow {
  flex: none;
  margin-left: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink3);
}

.hero {
  background: #0058f8;
  /* 彩色底叠加反白网点（halftone），增强复古质感 */
  background-image: radial-gradient(rgba(255, 255, 255, 0.18) 1.5rpx, transparent 1.6rpx);
  background-size: 8rpx 8rpx;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  padding: 28rpx 40rpx 36rpx;
  color: #ffffff;
}

.hero-done {
  background: #00a800;
  background-image: radial-gradient(rgba(255, 255, 255, 0.18) 1.5rpx, transparent 1.6rpx);
  background-size: 8rpx 8rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  margin: 0 0 8rpx;
}

.hero-sub {
  font-size: 28rpx;
  opacity: 0.95;
}

.hero-reason {
  margin-top: 12rpx;
  font-size: 23rpx;
  opacity: .82;
}

.hero-tags {
  display: flex;
  margin-top: 20rpx;
}

.h-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 0;
  border: var(--pxs) solid #ffd800;
  background: #0058f8;
  margin-right: 14rpx;
}

.hero-btns {
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
}

.hbtn {
  height: 84rpx;
  border-radius: 0;
  border: var(--pxs) solid var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  flex: 1;
}

.hbtn-solid {
  background: #ffd800;
  color: var(--ink);
}

/* 单独成行时按钮不拉满整行宽度，保持短一些 */
.hbtn-short {
  flex: none;
  padding: 0 96rpx;
}

.goal-card {
  margin-top: 28rpx;
}

.goal-guide {
  margin-top: 28rpx;
  border: var(--px) dashed var(--ink);
  background: var(--card2);
}

.goal-guide-title {
  font-size: 32rpx;
  font-weight: 700;
}

.goal-guide-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
}

.goal-guide-btn {
  flex: none;
  margin-left: 16rpx;
  padding: 14rpx 28rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  color: var(--card);
  background: var(--primary);
  font-size: 25rpx;
  font-weight: 700;
}

.progress-label {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  color: var(--ink2);
  font-size: 23rpx;
}

.progress-track {
  height: 16rpx;
  overflow: hidden;
  margin-top: 10rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  background: var(--card2);
}

.progress-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: 0;
  background: var(--primary);
  transition: width 0.35s steps(8, end);
}

.progress-fill.blue {
  background: #0058f8;
}

.coverage {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  font-size: 22rpx;
}

.coverage-tag {
  padding: 4rpx 12rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  color: var(--ink2);
  background: var(--card2);
}

.week-title {
  font-size: 32rpx;
  font-weight: 700;
}

/* 未登录：首页只展示登录入口 */
.login-guide {
  margin: 48rpx 8rpx 32rpx;
}

.login-guide-title {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--ink);
}

.login-guide-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.login-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  width: 100%;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow);
}

.login-avatar {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--pxs) solid var(--ink);
  background: var(--card2);
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 700;
}

.login-main {
  min-width: 0;
}

.login-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 800;
}

.login-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
}

/* 只有「点击登录」按钮可点击：重置 button 默认样式 */
button.login-pill {
  flex: none;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 14rpx 26rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  color: var(--card);
  background: var(--primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: 0;
}

button.login-pill::after {
  border: none;
}
