/* 底部预留自定义 tabBar 高度 */
.page {
  padding-top: 8rpx;
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
}

.head {
  display: flex;
  align-items: center;
  margin: 4rpx 8rpx 20rpx;
}

.head-date {
  font-size: 26rpx;
}

.head-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.head-note {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink2);
}

.head-note.streak {
  color: #b26a00;
}

/* 右上角排行榜入口：红底白字「排行榜」，替换原「今日开练」占位 */
.rank-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  padding: 0 16rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  background: var(--primary);
  color: var(--card);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

.hero {
  background: var(--blue);
  /* 彩色底叠加反白网点（halftone），增强复古质感 */
  background-image: radial-gradient(rgba(255, 255, 255, 0.18) 1.5rpx, transparent 1.6rpx);
  background-size: 8rpx 8rpx;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  padding: 28rpx 40rpx 36rpx;
  color: #ffffff;
}

.hero-done {
  background: var(--green);
  background-image: radial-gradient(rgba(255, 255, 255, 0.18) 1.5rpx, transparent 1.6rpx);
  background-size: 8rpx 8rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  margin: 0 0 8rpx;
}

.hero-sub {
  font-size: 28rpx;
  opacity: 0.95;
}

.hero-reason {
  margin-top: 12rpx;
  font-size: 23rpx;
  opacity: .82;
}

.hero-tags {
  display: flex;
  margin-top: 20rpx;
}

.h-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 0;
  border: var(--pxs) solid var(--primary-bg);
  background: var(--blue);
  margin-right: 14rpx;
}

.hero-btns {
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
}

.hbtn {
  height: 84rpx;
  border-radius: 0;
  border: var(--pxs) solid var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  flex: 1;
}

.hbtn-solid {
  background: var(--primary-bg);
  color: var(--ink);
}

/* 单独成行时按钮不拉满整行宽度，保持短一些 */
.hbtn-short {
  flex: none;
  padding: 0 96rpx;
}

.goal-card {
  margin-top: 28rpx;
}

.goal-guide {
  margin-top: 28rpx;
  border: var(--px) dashed var(--ink);
  background: var(--card2);
}

.goal-guide-title {
  font-size: 32rpx;
  font-weight: 700;
}

.goal-guide-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
}

.goal-guide-btn {
  flex: none;
  margin-left: 16rpx;
  padding: 14rpx 28rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  color: var(--card);
  background: var(--primary);
  font-size: 25rpx;
  font-weight: 700;
}

/* 周复盘卡片：像素标签 + 文本行，与全局卡片同一语言 */
.weekly { padding: 22rpx 24rpx; margin-top: 28rpx; }
.weekly-head { display: flex; align-items: center; justify-content: space-between; }
.weekly-title { color: var(--ink); font-size: 30rpx; font-weight: 700; }
.weekly-refresh { flex: none; font-size: 22rpx; font-weight: 700; color: var(--card); background: var(--green); border: var(--pxs) solid var(--ink); border-radius: 0; padding: 6rpx 18rpx; }
.weekly-hint { margin-top: 12rpx; font-size: 24rpx; }
.weekly-sec { display: flex; align-items: flex-start; margin-top: 16rpx; }
.weekly-tag { flex: none; font-size: 20rpx; font-weight: 700; line-height: 1; color: var(--card); border: var(--pxs) solid var(--ink); border-radius: 0; padding: 5rpx 12rpx; margin-top: 4rpx; }
.weekly-tag.hl { background: var(--green); }
.weekly-tag.imp { background: var(--ink2); }
.weekly-tag.nxt { background: var(--primary); }
.weekly-text { flex: 1; min-width: 0; margin-left: 14rpx; color: var(--ink); font-size: 25rpx; line-height: 1.6; }

.progress-label {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  color: var(--ink2);
  font-size: 23rpx;
}

.progress-track {
  height: 16rpx;
  overflow: hidden;
  margin-top: 10rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  background: var(--card2);
}

.progress-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: 0;
  background: var(--primary);
  transition: width 0.35s steps(8, end);
}

.progress-fill.blue {
  background: var(--blue);
}

.coverage {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  font-size: 22rpx;
}

.coverage-tag {
  padding: 4rpx 12rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  color: var(--ink2);
  background: var(--card2);
}

.week-title {
  font-size: 32rpx;
  font-weight: 700;
}

/* 未登录：首页只展示登录入口 */
.login-guide {
  margin: 48rpx 8rpx 32rpx;
}

.login-guide-title {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--ink);
}

.login-guide-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.login-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  width: 100%;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow);
}

.login-avatar {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--pxs) solid var(--ink);
  background: var(--card2);
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 700;
}

.login-main {
  min-width: 0;
}

.login-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 800;
}

.login-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
}

/* 只有「点击登录」按钮可点击：重置 button 默认样式 */
button.login-pill {
  flex: none;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 14rpx 26rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  color: var(--card);
  background: var(--primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: 0;
}

button.login-pill::after {
  border: none;
}
