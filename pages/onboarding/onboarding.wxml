<page-meta page-style="{{fontStyle}}"></page-meta>
<navigation-bar title="完善资料" back="{{false}}"></navigation-bar>
<px-toast></px-toast>
<import src="/components/prefs-form/prefs-form.wxml" />
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">

    <view class="steps">
      <view class="step {{step >= 1 ? 'on' : ''}}"><text class="step-no">1</text><text>训练偏好</text></view>
      <view class="step-line"></view>
      <view class="step {{step >= 2 ? 'on' : ''}}"><text class="step-no">2</text><text>自定义计划</text></view>
    </view>

    <block wx:if="{{step === 1}}">
      <view class="intro">
        <view class="intro-title">让每日推荐更懂你</view>
        <view class="weak intro-sub">花 10 秒选一下，首页推荐会更贴合你的目标</view>
      </view>

      <template is="prefsForm" data="{{goals, scenes, experiences, equipment, weeklyTargetDays, weeklyTargetMinutes, required: true}}" />

      <view class="bottom-space"></view>
    </block>
    <block wx:else>
      <view class="intro">
        <view class="intro-title">打造专属计划</view>
        <view class="weak intro-sub">从动作库自由组合动作，生成只属于你的训练计划</view>
      </view>

      <view class="g-card cp-entry" bindtap="goCustomPlan">
        <view class="row">
          <view class="cp-badge">计划</view>
          <view class="flex1 cp-main">
            <view class="cp-title">自定义计划</view>
            <view class="weak cp-sub">{{customHint}}</view>
          </view>
          <view class="cp-arrow">›</view>
        </view>
      </view>

      <view class="g-card section">
        <view class="section-title">设置后你会得到</view>
        <view class="cp-item">· 首页优先推荐你组合的训练计划</view>
        <view class="cp-item">· 居家 / 健身房各可保存一份专属计划</view>
        <view class="cp-item">· 动作、组数、目标全部按你的节奏设置</view>
      </view>

      <view class="bottom-space"></view>
    </block>

  </view>
</scroll-view>

<view class="save-bar foot-bar">
  <block wx:if="{{step === 1}}">
    <view class="foot-row">
      <view class="btn btn-ghost foot-ghost" bindtap="onSkipStep">跳过</view>
      <view class="btn btn-green foot-primary" bindtap="onNextStep">保存并继续</view>
    </view>
  </block>
  <block wx:else>
    <view class="foot-row">
      <view class="btn btn-ghost foot-ghost" bindtap="onPrevStep">上一步</view>
      <view class="btn btn-green foot-primary foot-stack" bindtap="onExit">
        <view class="foot-stack-main">完成</view>
        <view class="foot-stack-sub">后续可在「个人信息」中设置</view>
      </view>
    </view>
  </block>
</view>
