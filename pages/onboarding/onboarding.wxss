/* pages/onboarding/onboarding.wxss 登录后引导 */
page { height: 100vh; display: flex; flex-direction: column; background: var(--bg); }
.scrollarea { flex: 1; overflow-y: hidden; }
.page { padding: 24rpx 32rpx 200rpx; }

/* 步骤指示 */
.steps { display: flex; align-items: center; gap: 16rpx; margin: 8rpx 8rpx 28rpx; }
.step { display: flex; align-items: center; gap: 12rpx; color: var(--ink3); font-size: 26rpx; }
.step.on { color: var(--ink); font-weight: 700; }
.step-no { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border: var(--pxs) solid var(--ink); background: var(--card); color: var(--ink3); font-size: 24rpx; }
.step.on .step-no { background: var(--primary); color: var(--card); }
.step-line { flex: 1; height: var(--pxs); background: var(--ink); }

/* 标题 */
.intro { margin: 8rpx 8rpx 24rpx; }
.intro-title { color: var(--ink); font-size: 42rpx; font-weight: 800; }
.intro-sub { margin-top: 8rpx; font-size: 24rpx; }

/* 偏好表单（与偏好配置页一致） */
.section { margin-top: 20rpx; }
.section-title { color: var(--ink); font-size: 30rpx; font-weight: 700; }
.required-tag { margin-left: 12rpx; color: var(--primary); font-size: 22rpx; font-weight: 700; }
.goal-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.goal-item { flex: 0 0 calc((100% - 16rpx) / 2); min-height: 126rpx; box-sizing: border-box; padding: 20rpx; border: var(--pxs) solid var(--ink); border-radius: 0; background: var(--card); }
.goal-item.on { border-color: var(--ink); background: var(--primary-bg); box-shadow: var(--shadow); }
.goal-name { color: var(--ink); font-size: 26rpx; font-weight: 700; }
.goal-desc { margin-top: 7rpx; color: var(--ink3); font-size: 20rpx; line-height: 1.35; }
.chip-row { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 20rpx; }
.chip { padding: 13rpx 22rpx; border: var(--pxs) solid var(--ink); border-radius: 0; color: var(--ink2); font-size: 24rpx; }
.chip.on { border-color: var(--ink); color: var(--ink); background: var(--primary-bg); font-weight: 700; }
.slider-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding-top: 26rpx; color: var(--ink); font-size: 25rpx; }
.slider-copy { flex: none; width: 190rpx; }
.slider-row .weak { margin-top: 5rpx; font-size: 21rpx; }
.slider-area { flex: 1; min-width: 0; padding-top: 2rpx; }
.slider-row slider { width: 100%; }

/* 自定义计划入口 */
.cp-entry { margin-top: 20rpx; }
.cp-badge { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-right: 20rpx; border: var(--pxs) solid var(--ink); background: var(--primary-bg); color: var(--ink); font-size: 24rpx; font-weight: 700; }
.cn-main { min-width: 0; }
.cp-title { color: var(--ink); font-size: 30rpx; font-weight: 700; }
.cp-sub { margin-top: 8rpx; font-size: 24rpx; }
.cp-arrow { color: var(--ink3); font-size: 40rpx; }
.cp-item { margin-top: 16rpx; color: var(--ink2); font-size: 25rpx; line-height: 1.6; }

/* 底部操作条 */
.foot-bar { position: fixed; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; gap: 12rpx; padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: var(--px) solid var(--ink); background: var(--card); }
.foot-row { display: flex; align-items: stretch; gap: 20rpx; }
/* 按钮内两行文案：主操作 + 小字提示 */
.foot-stack { flex-direction: column; gap: 2rpx; height: auto; min-height: 92rpx; line-height: 1.15; }
.foot-stack-main { font-size: 30rpx; font-weight: 700; }
.foot-stack-sub { font-size: 20rpx; font-weight: 400; letter-spacing: 0; opacity: 0.9; }
.foot-ghost { flex: none; width: 200rpx; height: auto; box-shadow: var(--shadow); }
.btn.foot-ghost.hover { box-shadow: none; transform: translate(6rpx, 6rpx); opacity: 1; }
.foot-primary { flex: 1; }
/* 主操作按钮：引导内改用绿色，与红色区分 */
.btn-green { background: var(--green); color: var(--card); box-shadow: var(--shadow); }
.btn.btn-green.hover { box-shadow: none; transform: translate(6rpx, 6rpx); opacity: 1; }
.bottom-space { height: 24rpx; }
