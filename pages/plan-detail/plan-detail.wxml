<navigation-bar title="训练详情" color="#1A1A1A" background="#FFFFFF"></navigation-bar>
<px-toast></px-toast>
<scroll-view class="scrollarea" scroll-y type="list" wx:if="{{plan}}">
  <view class="page">

    <view class="head g-card">
      <view class="name">{{plan.name}}</view>
      <view class="meta sub">{{plan.duration}} 分钟 · 约 {{plan.calories}} kcal · {{plan.exTotal}} 个动作</view>
      <view class="summary">{{plan.summary}}</view>
    </view>

    <view class="notice">
      <view class="notice-title">训练提示</view>
      <view class="notice-text">{{plan.notice}}</view>
      <view class="notice-round">{{plan.roundsText}}</view>
    </view>

    <!-- 动作清单：修改组数后右上角提供「恢复默认」（visibility 控制显隐，占位恒定避免列表位移） -->
    <view class="ex-head">
      <view class="flex1">训练动作</view>
      <text class="adjust-reset {{!readonly && hasAdjustments ? '' : 'hide'}}" bindtap="onRestoreDefault">恢复默认</text>
    </view>

    <view class="g-card ex-list">
      <view
        class="ex-item"
        wx:for="{{items}}"
        wx:key="actionId"
        data-id="{{item.actionId}}"
        bindtap="goAction"
      >
        <view class="ex-idx">{{index + 1}}</view>
        <view class="flex1">
          <view class="ex-name">{{item.name}}</view>
          <view class="ex-meta weak">{{item.sets}} 组 × {{item.reps}}<text wx:if="{{item.rest}}"> · {{item.rest}}</text></view>
          <view class="set-adjust" wx:if="{{!readonly}}" catchtap="noop">
            <text class="set-label">组数</text>
            <text class="set-control {{item.canReduce ? '' : 'disabled'}}" data-id="{{item.actionId}}" data-delta="-1" catchtap="onAdjustSet">−</text>
            <text class="set-value">{{item.sets}}</text>
            <text class="set-control {{item.canIncrease ? '' : 'disabled'}}" data-id="{{item.actionId}}" data-delta="1" catchtap="onAdjustSet">＋</text>
          </view>
        </view>
        <text class="ex-arrow">›</text>
      </view>
    </view>

  </view>
</scroll-view>

<!-- 底部操作栏：只读模式不提供开始训练入口 -->
<view class="bar" wx:if="{{plan && !readonly}}">
  <view class="bar-info">
    <view class="bar-time num">{{plan.duration}} 分钟</view>
    <view class="bar-kcal weak">约 {{plan.calories}} kcal</view>
  </view>
  <view class="btn btn-primary bar-btn bar-main" bindtap="onWorkout">{{hasActiveSession ? '继续训练' : '开始训练'}}</view>
</view>

<view wx:if="{{showSwitchConfirm}}" class="px-mask" catchtouchmove="noop">
  <view class="px-dialog" catchtap="noop">
    <view class="px-dialog-title">有未完成训练</view>
    <view class="px-dialog-copy">是否放弃「{{switchActiveName}}」的进度</view>
    <view class="px-dialog-btns">
      <view class="px-dialog-btn cancel" bindtap="onCancelSwitch">取消</view>
      <view class="px-dialog-btn primary" bindtap="onConfirmSwitch">放弃并开始</view>
    </view>
  </view>
</view>
