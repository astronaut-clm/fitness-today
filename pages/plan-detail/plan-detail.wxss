.page {
  padding: 24rpx 32rpx 220rpx;
}

.head {
  background: var(--card2);
}

.name {
  font-size: 44rpx;
  font-weight: 800;
  margin-top: 16rpx;
}

.meta {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.summary {
  font-size: 26rpx;
  color: var(--ink2);
  margin-top: 16rpx;
}

.notice {
  background: var(--card2);
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  padding: 24rpx 28rpx;
  margin-top: 24rpx;
}

.notice-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.notice-text {
  font-size: 24rpx;
  color: var(--ink2);
  margin-top: 8rpx;
}

.notice-round {
  display: inline-flex;
  font-size: 22rpx;
  color: var(--ink2);
  background: var(--card);
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  padding: 6rpx 18rpx;
  margin-top: 14rpx;
}

.ex-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 700;
  margin: 32rpx 8rpx 16rpx;
}

.ex-head .adjust-reset {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--card);
  background: var(--green);
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  padding: 6rpx 18rpx;
}

/* 隐藏时保留占位：按钮出现/消失不改变行高，动作卡片不位移 */
.ex-head .adjust-reset.hide {
  visibility: hidden;
}

.ex-list {
  padding: 8rpx 28rpx;
}

.ex-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: var(--pxs) solid var(--line);
}

.ex-item:last-child {
  border-bottom: none;
}

.ex-idx {
  width: 52rpx;
  height: 52rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  background: var(--primary-bg);
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
}

.ex-name {
  font-size: 30rpx;
  font-weight: 600;
}

.ex-meta {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.set-adjust {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.set-label {
  color: var(--ink3);
  font-size: 20rpx;
}

.set-control, .set-value {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 0;
  font-size: 23rpx;
}

.set-control {
  color: var(--card);
  background: var(--primary);
  border: var(--pxs) solid var(--ink);
  font-weight: 700;
}

.set-control.disabled {
  color: var(--ink3);
  background: var(--card2);
  border-color: var(--ink3);
}

.set-value {
  width: 30rpx;
  color: var(--ink2);
  font-size: 22rpx;
}

.ex-arrow {
  color: var(--ink3);
  font-size: 36rpx;
  margin-left: 12rpx;
}


.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-top: var(--px) solid var(--ink);
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  z-index: 10;
}

.bar-info {
  margin-right: 24rpx;
  width: 150rpx;
  flex: none;
}

.bar-time {
  font-size: 30rpx;
}

.bar-kcal {
  font-size: 20rpx;
}

.bar-btn {
  flex: 1;
  height: 88rpx;
}

.bar-main {
  margin-left: 16rpx;
}
