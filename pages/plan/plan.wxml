<navigation-bar back="{{true}}" title="训练计划" color="#1A1A1A" background="#FFFFFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">

    <view class="seg">
      <view
        wx:for="{{sceneTabs}}"
        wx:key="value"
        class="seg-item {{scene === item.value ? 'on' : ''}}"
        data-scene="{{item.value}}"
        bindtap="onSceneTap"
      >{{item.name}}</view>
    </view>

    <view class="filter-row">
      <text class="weak">共 {{list.length}} 个计划</text>
      <view class="lv-chips">
        <view
          wx:for="{{levelTabs}}"
          wx:key="value"
          class="lv-chip {{level === item.value ? 'on' : ''}}"
          data-level="{{item.value}}"
          bindtap="onLevelTap"
        >{{item.name}}</view>
      </view>
    </view>

    <view wx:if="{{list.length === 0}}" class="empty g-card">
      <view class="empty-title">暂无匹配计划</view>
      <view class="empty-sub weak">试试切换难度筛选</view>
    </view>

    <view
      class="plan g-card"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="plan-top">
        <view class="row flex1">
          <text wx:if="{{item.recommended}}" class="tag tag-rec">今日推荐</text>
          <text wx:if="{{item.custom}}" class="tag tag-custom">自定义</text>
          <text wx:else class="tag">{{item.level}}</text>
        </view>
        <text wx:if="{{item.doneCount}}" class="plan-meta plan-done">已完成 x{{item.doneCount}}</text>
      </view>
      <view class="plan-name">{{item.name}}</view>
      <view class="plan-summary sub">{{item.summary}}</view>
      <view class="plan-tags" wx:if="{{item.tags.length}}">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
      <view class="plan-foot">
        <text class="weak">{{item.exCount}} 个动作 · {{item.roundsText}}</text>
        <text class="plan-more {{pick && item.continuing ? 'plan-more-continue' : ''}}">{{pick ? (item.continuing ? '继续训练 ›' : '选择并开始 ›') : '查看详情 ›'}}</text>
      </view>
    </view>

    <view class="tip">新朋友建议从「初级」难度开始，动作不会做可先去「动作库」学习。</view>

  </view>
</scroll-view>
