.page {
  padding: 24rpx 32rpx 48rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 8rpx 20rpx;
}

.lv-chips {
  display: flex;
}

.lv-chip {
  font-size: 24rpx;
  color: var(--ink2);
  padding: 8rpx 22rpx;
  border-radius: 0;
  background: var(--card);
  border: var(--pxs) solid var(--ink);
  margin-left: 14rpx;
}

.lv-chip.on {
  background: var(--primary);
  border-color: var(--ink);
  color: var(--card);
  font-weight: 700;
}

.plan {
  margin-bottom: 24rpx;
}

.plan-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-top .tag {
  margin-right: 12rpx;
}

.plan-meta {
  font-size: 22rpx;
}

.plan-done {
  color: var(--green);
  font-size: 22rpx;
  font-weight: 700;
}

.plan-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 18rpx;
}

.plan-summary {
  font-size: 26rpx;
  margin-top: 8rpx;
}

.plan-tags {
  display: flex;
  margin-top: 16rpx;
}

.plan-tags .tag {
  margin-right: 12rpx;
}

.plan-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: var(--pxs) solid var(--line);
  font-size: 24rpx;
}

.plan-more {
  color: var(--ink);
  font-weight: 700;
}

/* 进行中训练的入口：红色强调 */
.plan-more-continue {
  color: var(--primary);
}

.empty {
  padding: 80rpx 0;
}

.tip {
  font-size: 24rpx;
  color: var(--ink3);
  text-align: center;
  padding: 20rpx 40rpx;
}
