/* pages/plan/plan.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 24rpx 32rpx 48rpx;
}

/* 场景切换 */
.seg {
  display: flex;
  background: var(--card2);
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  padding: 8rpx;
}

.seg-item {
  flex: 1;
  height: 76rpx;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink2);
}

.seg-item.on {
  background: var(--primary);
  color: var(--card);
}

/* 筛选行 */
.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 8rpx 20rpx;
}

.lv-chips {
  display: flex;
}

.lv-chip {
  font-size: 24rpx;
  color: var(--ink2);
  padding: 8rpx 22rpx;
  border-radius: 0;
  background: var(--card);
  border: var(--pxs) solid var(--ink);
  margin-left: 14rpx;
}

.lv-chip.on {
  background: var(--primary);
  border-color: var(--ink);
  color: var(--card);
  font-weight: 700;
}

/* 计划卡片 */
.plan {
  margin-bottom: 24rpx;
}

.plan-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-top .tag {
  margin-right: 12rpx;
}

.plan-meta {
  font-size: 22rpx;
}

.plan-done {
  color: var(--green);
  font-size: 22rpx;
  font-weight: 700;
}

.plan-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 18rpx;
}

.plan-summary {
  font-size: 26rpx;
  margin-top: 8rpx;
}

.plan-tags {
  display: flex;
  margin-top: 16rpx;
}

.plan-tags .tag {
  margin-right: 12rpx;
}

.plan-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: var(--pxs) solid var(--line);
  font-size: 24rpx;
}

.plan-more {
  color: var(--ink);
  font-weight: 700;
}

/* 进行中训练的入口：红色强调 */
.plan-more-continue {
  color: var(--primary);
}

.hover {
  opacity: 0.86;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
}

.empty-sub {
  font-size: 26rpx;
  margin-top: 10rpx;
}

.tip {
  font-size: 24rpx;
  color: var(--ink3);
  text-align: center;
  padding: 20rpx 40rpx;
}
