/* pages/rank/rank.wxss 排行榜 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 24rpx 32rpx 48rpx;
}

.rank-head {
  margin: 8rpx 8rpx 24rpx;
}

.rank-month {
  font-size: 40rpx;
  font-weight: 800;
}

.rank-sub {
  font-size: 23rpx;
  margin-top: 8rpx;
}

.loading-box {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

/* 我的名次卡 */
.me-card {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.me-rank {
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.me-rank-num {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.1;
  color: var(--primary);
}

.me-rank-label {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.me-line {
  width: var(--pxs);
  align-self: stretch;
  background: var(--ink);
  margin: 0 24rpx;
}

.me-minutes {
  font-size: 38rpx;
  font-weight: 700;
}

.me-unit {
  font-size: 24rpx;
  font-weight: 400;
}

.me-sub {
  font-size: 23rpx;
  margin-top: 8rpx;
}

/* 榜单列表 */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rank-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.rank-row.me {
  background: #fff7c9;
}

.rank-no {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  border: var(--pxs) solid var(--ink);
  margin-right: 20rpx;
}

.rank-no-n {
  border: none;
  color: var(--ink2);
}

.rank-no-1 {
  background: var(--primary-bg);
  color: var(--ink);
}

.rank-no-2,
.rank-no-3 {
  background: var(--card2);
  color: var(--ink);
}

.rank-avatar-box {
  flex: none;
  margin-right: 18rpx;
}

.rank-avatar {
  width: 72rpx;
  height: 72rpx;
  display: block;
  border: var(--pxs) solid var(--ink);
}

.rank-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card2);
  font-size: 30rpx;
  font-weight: 700;
}

.rank-info {
  min-width: 0;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-me-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border: var(--pxs) solid var(--ink);
  background: var(--primary);
  color: var(--card);
}

.rank-meta {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.rank-minutes {
  flex: none;
  margin-left: 16rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.rank-unit {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 4rpx;
}

/* 空态 / 失败 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 20rpx;
}

.empty-icon {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--ink3);
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  margin-top: 10rpx;
  text-align: center;
}

.retry-btn {
  margin-top: 28rpx;
  padding: 16rpx 48rpx;
  border: var(--pxs) solid var(--ink);
  background: var(--primary);
  color: var(--card);
  font-size: 26rpx;
  font-weight: 700;
}

.bottom-space {
  height: 40rpx;
}

.hover {
  opacity: 0.86;
}
