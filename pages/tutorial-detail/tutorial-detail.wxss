page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 20rpx 32rpx 48rpx;
}

.hover {
  opacity: 0.86;
}

.hero {
  background: #0058f8;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  padding: 44rpx 40rpx;
  color: #ffffff;
}

.hero-top {
  display: flex;
  align-items: center;
}

.hero-tags {
  display: flex;
  flex: 1;
  min-width: 0;
}

/* 难度置于头部卡片右上角，白底反色覆盖 tag-lv* 的底色 */
.hero .hero-level {
  flex: none;
  margin-left: 16rpx;
  background: #ffffff;
  color: var(--ink);
  font-weight: 700;
}

.h-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border: var(--pxs) solid #ffd800;
  border-radius: 0;
  background: #0058f8;
  margin-right: 14rpx;
}

.hero-name {
  font-size: 56rpx;
  font-weight: 800;
  margin-top: 18rpx;
}

.hero-meta {
  font-size: 26rpx;
  opacity: 0.92;
  margin-top: 10rpx;
}

.hero-summary {
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.92;
  margin-top: 20rpx;
}

.anim-card {
  background: #ffffff;
  border: var(--px) solid var(--ink);
  box-shadow: var(--shadow);
  padding: 24rpx;
}

.anim-title {
  margin-bottom: 16rpx;
}

.anim-frame {
  /* 源视频为 1:1 正方形，容器须同比例，否则 <video> 补边处会露出原生黑底。
     容器固定尺寸 + 裁剪溢出：<video> 原生层按物理像素取整，边缘总会差出不到 1px；
     由容器裁掉视频多出的部分，任何机型的取整误差都落在容器外面，不会露出黑线 */
  width: 420rpx;
  height: 420rpx;
  margin: 0 auto;
  overflow: hidden;
}

.anim-img {
  display: block;
  /* 四周各比容器大 2rpx，多出的部分被 anim-frame 裁掉；background 兜底防止缝隙透黑 */
  width: calc(100% + 4rpx);
  height: calc(100% + 4rpx);
  margin: -2rpx;
  background: #ffffff;
}

.g-card {
  margin-top: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.kv {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

/* 训练步骤：步骤 + 该步要点 */
.step {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.step-body {
  flex: 1;
}

.step-text {
  font-size: 27rpx;
  color: var(--ink);
  line-height: 1.5;
}

.step-key {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink2);
  line-height: 1.5;
}

.kv-dot {
  color: var(--ink);
  font-weight: 700;
  font-size: 28rpx;
  margin: 0 16rpx 0 4rpx;
  line-height: 1.5;
}

.kv-text {
  flex: 1;
  font-size: 27rpx;
  color: var(--ink);
}

.step-idx {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  background: var(--primary-bg);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.guide-card {
  margin-top: 24rpx;
}

.tempo {
  padding: 18rpx 20rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  color: var(--ink2);
  background: var(--card2);
  font-size: 25rpx;
}

.mistakes-title {
  margin-top: 26rpx;
}

.warn-dot {
  color: var(--ink2);
}

.caution {
  margin-top: 24rpx;
  background: var(--card2);
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  padding: 26rpx 28rpx;
}

.caution-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.caution-text {
  font-size: 25rpx;
  color: var(--ink2);
  margin-top: 8rpx;
}

.rel-head {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  margin: 36rpx 8rpx 16rpx;
}

.rel {
  padding: 8rpx 28rpx;
}

.rel-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: var(--pxs) solid var(--line);
}

.rel-item:last-child {
  border-bottom: none;
}

.rel-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.rel-item .tag {
  margin-right: 10rpx;
}

.rel-arrow {
  color: var(--ink3);
  font-size: 36rpx;
}
