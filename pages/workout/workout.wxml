<px-toast></px-toast>
<!-- 自绘顶部导航：返回点击直接绑定页面方法 -->

  <view class="workout-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="workout-nav-inner">
      <view class="workout-nav-back" bindtap="onNavBack" aria-role="button" aria-label="返回">
        <text class="workout-nav-arrow">‹</text>
      </view>
      <view class="workout-nav-title">训练跟练</view>
    </view>
  </view>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page" wx:if="{{loaded}}">
    <view class="top">
      <view class="flex1">
        <view class="plan-row">
          <view class="plan">{{planName}}</view>
          <view wx:if="{{voiceSupported}}" class="plan-voice" bindtap="onToggleVoice" aria-role="button" aria-label="{{voiceOn ? '关闭语音播报' : '开启语音播报'}}">
            <text class="plan-voice-txt {{voiceOn ? 'on' : ''}}">{{voiceOn ? '语音开' : '语音关'}}</text>
          </view>
        </view>
        <view class="plan-sub weak">{{sceneName}} · 共 {{total}} 组动作</view>
      </view>
    </view>

    <block wx:if="{{state === 'finished'}}">
      <view class="g-card panel done">
        <view class="done-ico">✓</view>
        <view class="done-title">{{doneTitle}}</view>
        <view class="done-sub sub">{{planName}} · {{total - skippedGroups}}/{{total}} 组完成 · 用时 {{costText}}</view>
        <view class="done-cheer">{{doneCheer}}</view>

        <view class="done-stats">
          <view class="ds-item" wx:for="{{doneStats}}" wx:key="label">
            <view class="ds-val">{{item.value}}</view>
            <view class="ds-label weak">{{item.label}}</view>
          </view>
        </view>

        <view class="share-row">
          <button wx:if="{{canShareFeed}}" class="share-btn {{feedPosted || feedPosting ? 'posted' : 'primary'}}" hover-class="none" bindtap="onShareToFeed">{{feedPosted ? '已分享铁友圈' : (feedPosting ? '分享中…' : '分享铁友圈')}}</button>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="prog">
        <view class="prog-track"><view class="prog-bar" style="{{pctStyle}}"></view></view>
        <view class="prog-row">
          <text class="weak">已完成 {{completed}} / {{total}} 组</text>
          <text class="prog-txt">当前第 {{group.setNo}} 组</text>
        </view>
      </view>

      <view wx:if="{{state === 'rest'}}" class="g-card panel rest">
        <view class="panel-label">休息一下</view>
        <view class="big-num">{{restLeft}}</view>
        <view class="big-unit weak">秒</view>
        <view class="rest-next weak">下一组：{{group.name}}<text wx:if="{{group.targetText}}"> · {{group.targetText}}</text></view>
        <view class="actions">
          <view class="btn btn-ghost act-btn half" bindtap="extendRest">+15 秒</view>
          <view class="btn btn-primary act-btn half" bindtap="skipRest">跳过休息</view>
        </view>
      </view>

      <view wx:elif="{{state === 'working' && group}}" class="g-card panel">
        <view class="g-tags">
          <text class="g-tag">{{group.category}}</text>
          <text class="g-tag" wx:if="{{group.equipment}}">{{group.equipment}}</text>
          <text class="g-tag" wx:if="{{group.roundLabel}}">{{group.roundLabel}}</text>
        </view>
        <view class="g-name">{{group.name}}</view>
        <view class="g-target sub">目标：{{group.targetText}}</view>
        <view class="next-preview weak" wx:if="{{nextGroup}}">下一组：{{nextGroup.name}} · {{nextGroup.targetText}}</view>

        <block wx:if="{{group.kind === 'time'}}">
          <view class="big-num timer">{{workLeft}}</view>
          <view class="big-unit weak">秒 · 倒数结束后自动进入下一组</view>
        </block>
        <view class="g-tip weak" wx:else>请按标准完成本组目标后，点击下方按钮</view>

        <view class="actions">
          <block wx:if="{{group.kind === 'time'}}">
            <view wx:if="{{running}}" class="btn btn-ghost act-btn half" bindtap="onPauseWork">暂停</view>
            <view wx:else class="btn btn-ghost act-btn half" bindtap="onStartWork">{{timeStarted ? '继续计时' : '开始计时'}}</view>
            <view class="btn btn-primary act-btn half" bindtap="onCompleteSet">本组完成</view>
          </block>
          <view wx:else class="btn btn-primary act-btn" bindtap="onCompleteSet">本组完成</view>
        </view>
        <view class="skip-set weak" bindtap="onSkipSet">跳过本组</view>
      </view>
    </block>
  </view>
</scroll-view>

<view wx:if="{{showResumeConfirm}}" class="px-mask" catchtouchmove="noop">
  <view class="px-dialog" catchtap="noop">
    <view class="px-dialog-title">继续上次训练？</view>
    <view class="px-dialog-copy">已完成 {{resumeDone}}/{{total}} 组，可继续或重新开始</view>
    <view class="px-dialog-btns">
      <view class="px-dialog-btn cancel" bindtap="onResumeRestart">重新开始</view>
      <view class="px-dialog-btn primary" bindtap="onResumeContinue">继续训练</view>
    </view>
  </view>
</view>
