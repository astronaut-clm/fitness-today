.page {
  padding: 20rpx 32rpx 220rpx;
}

/* 自绘顶部导航：返回与动作按钮用同一套事件机制 */
.workout-nav {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg);
  flex: none;
}

.workout-nav-inner {
  position: relative;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.workout-nav-back {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 16px;
  box-sizing: border-box;
  z-index: 10;
}

/* 与系统导航返回箭头同款：‹ 12x24px、字号 20px */
.workout-nav-arrow {
  width: 12px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  line-height: 1;
  color: var(--ink);
}

.workout-nav-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--ink);
}

/* 语音开关：与计划名同行右对齐（插件可用时展示） */
.plan-voice {
  flex: none;
  margin-left: 16rpx;
}

.plan-voice-txt {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1;
  color: var(--ink2);
  background: var(--card2);
  border: var(--pxs) solid var(--ink);
  padding: 10rpx 16rpx;
}

.plan-voice-txt.on {
  color: var(--card);
  background: var(--green);
}

.top {
  display: flex;
  align-items: center;
  padding: 8rpx;
}

/* 计划名与语音开关同行、顶部对齐 */
.plan-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan {
  flex: 1;
  min-width: 0;
  font-size: 38rpx;
  font-weight: 800;
}

.plan-sub {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.prog {
  margin-top: 36rpx;
}

.prog-track {
  height: 18rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  background: var(--card2);
  overflow: hidden;
}

.prog-bar {
  height: 100%;
  border-radius: 0;
  background: var(--primary);
  transition: width 0.3s steps(8, end);
}

.prog-row {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 24rpx;
}

.prog-txt {
  color: var(--ink);
  font-weight: 700;
}

/* 复用全局 .g-card 样式，仅覆盖间距与对齐 */
.panel {
  padding: 64rpx 40rpx 48rpx;
  margin-top: 32rpx;
  text-align: center;
}

.panel-label {
  font-size: 26rpx;
  color: var(--ink2);
  letter-spacing: 4rpx;
}

.panel.rest {
  padding-top: 72rpx;
  /* 只改底色，保留 .g-card 的网点纹理 */
  background-color: var(--card2);
}

.big-num {
  font-size: 150rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.05;
  margin-top: 30rpx;
  font-variant-numeric: tabular-nums;
}

.panel.rest .big-num {
  color: var(--ink2);
}

.big-unit {
  font-size: 26rpx;
  margin-top: 6rpx;
  display: block;
}

.rest-next {
  font-size: 26rpx;
  margin-top: 40rpx;
}

.g-tags {
  display: flex;
  justify-content: center;
}

.g-tag {
  font-size: 22rpx;
  color: var(--ink2);
  background: var(--card2);
  border: var(--pxs) solid var(--ink);
  padding: 6rpx 20rpx;
  border-radius: 0;
  margin: 0 8rpx;
}

.g-name {
  font-size: 56rpx;
  font-weight: 800;
  margin-top: 24rpx;
}

.g-target {
  font-size: 28rpx;
  margin-top: 10rpx;
}

.timer {
  color: var(--ink);
  font-weight: 700;
}

.g-tip {
  font-size: 24rpx;
  margin-top: 52rpx;
  display: block;
}

.actions {
  display: flex;
  margin-top: 48rpx;
}

.act-btn {
  flex: 1;
  height: 96rpx;
  font-size: 32rpx;
  margin: 0 8rpx;
}

.act-btn.half {
  margin: 0;
}

.act-btn.half + .act-btn.half {
  margin-left: 16rpx;
}

.done {
  margin-top: 56rpx;
  padding-top: 80rpx;
}

.done-ico {
  width: 128rpx;
  height: 128rpx;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  background: var(--green);
  color: var(--card);
  font-size: 68rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.done-title {
  font-size: 46rpx;
  font-weight: 800;
  margin-top: 36rpx;
}

.done-sub {
  font-size: 26rpx;
  margin-top: 10rpx;
}

.done-cheer {
  font-size: 26rpx;
  color: var(--ink2);
  margin-top: 24rpx;
  line-height: 1.7;
}

.done-stats {
  display: flex;
  margin-top: 40rpx;
  background: var(--card2);
  border: var(--pxs) solid var(--ink);
}

.ds-item {
  flex: 1;
  padding: 18rpx 0;
}

.ds-item + .ds-item {
  border-left: var(--pxs) solid var(--ink);
}

.ds-val {
  font-size: 34rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.ds-label {
  font-size: 20rpx;
  margin-top: 6rpx;
}

.share-row {
  margin-top: 44rpx;
}

/* button 需重置默认样式才能贴合像素风 */
.share-btn {
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 2rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-btn::after {
  border: none;
}

.share-btn.primary {
  background: var(--primary);
  color: var(--card);
}

.share-btn.posted {
  background: var(--card2);
  color: var(--ink2);
}

.next-preview {
  font-size: 22rpx;
  margin-top: 18rpx;
}

.skip-set {
  display: inline-block;
  font-size: 24rpx;
  margin-top: 26rpx;
  padding: 8rpx 20rpx;
}
