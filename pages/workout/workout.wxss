/* pages/workout/workout.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 20rpx 32rpx 220rpx;
}

.hover {
  opacity: 0.86;
}

/* 自绘顶部导航（页面树内元素，返回点击与动作按钮同一套事件机制） */
.workout-nav {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg);
  flex: none;
}

.workout-nav-inner {
  position: relative;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.workout-nav-back {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 16px;
  box-sizing: border-box;
  z-index: 10;
}

/* 与系统导航默认返回箭头同款：‹ 宽12px 高24px 字号20px */
.workout-nav-arrow {
  width: 12px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  line-height: 1;
  color: var(--ink);
}

.workout-nav-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--ink);
}

/* 顶部计划信息 */
.top {
  display: flex;
  align-items: center;
  padding: 8rpx;
}

.plan {
  font-size: 38rpx;
  font-weight: 800;
}

.plan-sub {
  font-size: 24rpx;
  margin-top: 6rpx;
}

/* 进度 */
.prog {
  margin-top: 36rpx;
}

.prog-track {
  height: 18rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  background: var(--card2);
  overflow: hidden;
}

.prog-bar {
  height: 100%;
  border-radius: 0;
  background: var(--primary);
  transition: width 0.3s steps(8, end);
}

.prog-row {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 24rpx;
}

.prog-txt {
  color: var(--ink);
  font-weight: 700;
}

/* 面板 */
.panel {
  background: var(--card);
  /* 抖动网点：与全局 .g-card 一致的 4x4 棋盘颗粒 */
  background-image:
    linear-gradient(45deg, rgba(26, 26, 26, 0.05) 25%, transparent 25%, transparent 75%, rgba(26, 26, 26, 0.05) 75%),
    linear-gradient(45deg, rgba(26, 26, 26, 0.05) 25%, transparent 25%, transparent 75%, rgba(26, 26, 26, 0.05) 75%);
  background-size: 8rpx 8rpx;
  background-position: 0 0, 4rpx 4rpx;
  border: var(--px) solid var(--ink);
  box-shadow: var(--shadow);
  border-radius: 0;
  padding: 64rpx 40rpx 48rpx;
  margin-top: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.panel-label {
  font-size: 26rpx;
  color: var(--ink2);
  letter-spacing: 4rpx;
}

.panel.rest {
  padding-top: 72rpx;
  background: var(--card2);
  background-image:
    linear-gradient(45deg, rgba(26, 26, 26, 0.05) 25%, transparent 25%, transparent 75%, rgba(26, 26, 26, 0.05) 75%),
    linear-gradient(45deg, rgba(26, 26, 26, 0.05) 25%, transparent 25%, transparent 75%, rgba(26, 26, 26, 0.05) 75%);
  background-size: 8rpx 8rpx;
  background-position: 0 0, 4rpx 4rpx;
}

.big-num {
  font-size: 150rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.05;
  margin-top: 30rpx;
  font-variant-numeric: tabular-nums;
}

.panel.rest .big-num {
  color: var(--ink2);
}

.big-unit {
  font-size: 26rpx;
  margin-top: 6rpx;
  display: block;
}

.rest-next {
  font-size: 26rpx;
  margin-top: 40rpx;
}

/* 动作信息 */
.g-tags {
  display: flex;
  justify-content: center;
}

.g-tag {
  font-size: 22rpx;
  color: var(--ink2);
  background: var(--card2);
  border: var(--pxs) solid var(--ink);
  padding: 6rpx 20rpx;
  border-radius: 0;
  margin: 0 8rpx;
}

.g-name {
  font-size: 56rpx;
  font-weight: 800;
  margin-top: 24rpx;
}

.g-target {
  font-size: 28rpx;
  margin-top: 10rpx;
}

.timer {
  color: var(--ink);
  font-weight: 700;
}

.g-tip {
  font-size: 24rpx;
  margin-top: 52rpx;
  display: block;
}

.actions {
  display: flex;
  margin-top: 48rpx;
}

.act-btn {
  flex: 1;
  height: 96rpx;
  font-size: 32rpx;
  margin: 0 8rpx;
}

.act-btn.half {
  margin: 0;
}

.act-btn.half + .act-btn.half {
  margin-left: 16rpx;
}

/* 完成态 */
.done {
  margin-top: 56rpx;
  padding-top: 80rpx;
}

.done-ico {
  width: 128rpx;
  height: 128rpx;
  border: var(--px) solid var(--ink);
  border-radius: 0;
  background: var(--primary);
  color: var(--card);
  font-size: 68rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.done-title {
  font-size: 46rpx;
  font-weight: 800;
  margin-top: 36rpx;
}

.done-sub {
  font-size: 26rpx;
  margin-top: 10rpx;
}

.done-btn {
  margin-top: 40rpx;
  background: var(--primary);
  color: var(--card);
}

.next-preview {
  font-size: 22rpx;
  margin-top: 18rpx;
}

.skip-set {
  display: inline-block;
  font-size: 24rpx;
  margin-top: 26rpx;
  padding: 8rpx 20rpx;
}

/* 退出确认弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 26, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog {
  width: 600rpx;
  background: var(--card);
  border: var(--px) solid var(--ink);
  box-shadow: var(--shadow);
  border-radius: 0;
  padding: 48rpx 40rpx 36rpx;
  box-sizing: border-box;
  text-align: center;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
}

.dialog-content {
  font-size: 28rpx;
  color: var(--ink2);
  margin-top: 18rpx;
  line-height: 1.6;
}

.dialog-btns {
  display: flex;
  margin-top: 44rpx;
}

.dialog-btn {
  flex: 1;
  height: 88rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.dialog-btn + .dialog-btn {
  margin-left: 20rpx;
}

.dialog-btn.ghost {
  background: var(--card2);
  color: var(--ink2);
}

.dialog-btn.primary {
  background: var(--primary);
  color: var(--card);
}

.feedback {
  margin-top: 38rpx;
  padding: 24rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  background: var(--card2);
}

.feedback-title {
  font-size: 26rpx;
  font-weight: 700;
}

.efforts {
  display: flex;
  justify-content: center;
  margin-top: 18rpx;
}

.effort {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border: var(--pxs) solid var(--ink);
  border-radius: 0;
  color: var(--ink2);
  background: var(--card);
  margin: 0 8rpx;
  font-size: 24rpx;
}

.effort.on {
  color: var(--card);
  background: var(--primary);
}

.feedback-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
}
